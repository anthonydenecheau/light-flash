# Configuration ESP-IDF commune à tout le workspace.
# Toute modification déclenche une recompilation complète d'ESP-IDF.

CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Tick FreeRTOS à 1000 Hz (100 Hz par défaut) pour des sleeps à la ms.
#CONFIG_FREERTOS_HZ=1000

# Contournement de https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n

# Bluetooth Low Energy via NimBLE (esp32-nimble), Bluedroid désactivé.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
