# Configuration ESP-IDF commune à tout le workspace.
# Toute modification déclenche une recompilation complète d'ESP-IDF.

# La tâche principale ne fait que l'initialisation puis un journal périodique.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Taille de l'image : code C d'ESP-IDF compilé en -Os (au lieu de -Og), pas de paquet de
# certificats TLS (aucune connexion sortante chiffrée). Deux emplacements OTA de 1,94 Mo.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
# Fonctions Wi-Fi inutiles sur une lampe domestique : WPA2-Entreprise, roaming 802.11r, WPS.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_11R_SUPPORT=n
# IPv6 non utilisé (mDNS et la page fonctionnent en IPv4) : code et tampons en moins.
CONFIG_LWIP_IPV6=n

# Nom envoyé à la box par DHCP (option 12) : http://light-flash/ sur beaucoup de box.
CONFIG_LWIP_LOCAL_HOSTNAME="light-flash"

# Mise à jour par le réseau : une image fraîchement installée doit se déclarer valide au
# démarrage (mark_running_slot_valid), sinon le bootloader revient à la précédente.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Tick FreeRTOS à 1000 Hz (100 Hz par défaut) pour des sleeps à la ms.
#CONFIG_FREERTOS_HZ=1000

# Contournement de https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n

# Bluetooth Low Energy via NimBLE (esp32-nimble), Bluedroid désactivé.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# La lampe n'est que périphérique (Improv) : une connexion, pas de rôle central ni observateur,
# tampons réduits. Le tas libre était tombé à 40 Ko avec la configuration par défaut.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=12
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=10

# Wi-Fi : tampons réduits (une page HTML et quelques requêtes JSON, pas de gros débit).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
